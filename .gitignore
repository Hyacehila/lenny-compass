# Secrets and local configuration
.env
.env.*
!.env.example

# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# JavaScript dependencies and build output
node_modules/
dist/
coverage/
.next/
*.tsbuildinfo
output/playwright/
.playwright-cli/

# Fact builds publish versioned artifacts, but never commit interrupted staging.
facts/.fact-build-staging-*/

# Generated retrieval data and runtime state; retain directory scaffolding.
retrieval/**
!retrieval/**/
!retrieval/**/.gitkeep
!retrieval/lexical/fts.sqlite3
!retrieval/semantic/vec.sqlite3
!retrieval/manifests/build.json
runtime/**
!runtime/**/
!runtime/**/.gitkeep

# Evaluation output is reproducible; evaluation cases remain versioned.
evals/results/**
!evals/results/.gitkeep

# Operating-system files
.DS_Store
Thumbs.db
