{
  "$defs": {
    "CaseObservation": {
      "additionalProperties": false,
      "properties": {
        "answer_kind": {
          "anyOf": [
            {
              "enum": [
                "answer",
                "refusal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Kind"
        },
        "case_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClaimObservation"
          },
          "title": "Claims",
          "type": "array"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "grounded_evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Grounded Evidence Ids",
          "type": "array"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "outcome": {
          "default": "completed",
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "truncated"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "retrieved_evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Retrieved Evidence Ids",
          "type": "array"
        },
        "trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "case_id"
      ],
      "title": "CaseObservation",
      "type": "object"
    },
    "ClaimObservation": {
      "additionalProperties": false,
      "properties": {
        "citation_ids": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Citation Ids",
          "type": "array"
        },
        "claim_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "expectation_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expectation Id"
        }
      },
      "required": [
        "claim_id"
      ],
      "title": "ClaimObservation",
      "type": "object"
    },
    "JsonValue": {},
    "ToolEvent": {
      "additionalProperties": false,
      "properties": {
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "error",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool"
      ],
      "title": "ToolEvent",
      "type": "object"
    },
    "TraceObservation": {
      "additionalProperties": false,
      "properties": {
        "completed": {
          "title": "Completed",
          "type": "boolean"
        },
        "events": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "termination_reason": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Termination Reason"
        }
      },
      "required": [
        "completed"
      ],
      "title": "TraceObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseObservation"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "ai-pm.eval.observation-set.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "suite_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Suite Id",
      "type": "string"
    },
    "system_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "System Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "suite_id",
    "system_id",
    "cases"
  ],
  "title": "ObservationSet",
  "type": "object"
}
