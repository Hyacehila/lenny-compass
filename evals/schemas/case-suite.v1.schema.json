{
  "$defs": {
    "BudgetExpectation": {
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Input Tokens"
        },
        "max_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Latency Ms"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        }
      },
      "title": "BudgetExpectation",
      "type": "object"
    },
    "CaseExpectation": {
      "additionalProperties": false,
      "properties": {
        "answer_kind": {
          "default": "answer",
          "enum": [
            "answer",
            "refusal",
            "either"
          ],
          "title": "Answer Kind",
          "type": "string"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/BudgetExpectation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expected_claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExpectedClaim"
          },
          "title": "Expected Claims",
          "type": "array"
        },
        "relevant_evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Relevant Evidence Ids",
          "type": "array"
        },
        "trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceExpectation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CaseExpectation",
      "type": "object"
    },
    "EvaluationCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "expectation": {
          "$ref": "#/$defs/CaseExpectation"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "query": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "query",
        "expectation"
      ],
      "title": "EvaluationCase",
      "type": "object"
    },
    "ExpectedClaim": {
      "additionalProperties": false,
      "properties": {
        "acceptable_evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptable Evidence Ids",
          "type": "array"
        },
        "claim_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "acceptable_evidence_ids"
      ],
      "title": "ExpectedClaim",
      "type": "object"
    },
    "JsonValue": {},
    "TraceExpectation": {
      "additionalProperties": false,
      "properties": {
        "forbidden_tools": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Forbidden Tools",
          "type": "array"
        },
        "max_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Steps"
        },
        "require_completed": {
          "default": true,
          "title": "Require Completed",
          "type": "boolean"
        },
        "required_tools": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Tools",
          "type": "array"
        }
      },
      "title": "TraceExpectation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/EvaluationCase"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "description": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "schema_version": {
      "const": "ai-pm.eval.case-suite.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "suite_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Suite Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "suite_id",
    "description",
    "cases"
  ],
  "title": "CaseSuite",
  "type": "object"
}
