    {
      "children": [],
      "content_layer": "body",
      "formatting": null,
      "hyperlink": null,
      "label": "text",
      "meta": null,
      "orig": "I’m taking this week off to be fully present on my trip to Wimbledon with my dad. I told my dad a decade ago that I’d take him to all of the Grand Slams of tennis, and with this trip, we’ve done them all.",
      "parent": {
        "$ref": "#/body"
      },
      "prov": [],
      "self_ref": "#/texts/1",
      "text": "I’m taking this week off to be fully present on my trip to Wimbledon with my dad. I told my dad a decade ago that I’d take him to all of the Grand Slams of tennis, and with this trip, we’ve done them all."
    },
