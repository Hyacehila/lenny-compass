      "formatting": null,
      "hyperlink": null,
      "label": "text",
      "meta": null,
      "orig": "I even snuck in a community meetup while in London, and let me tell you, the London product community is extraordinary. So much energy, so many great ideas, and such nice people! Big thank-you to Index Ventures for hosting this unbelievable crowd 😮",
      "parent": {
        "$ref": "#/body"
      },
      "prov": [],
