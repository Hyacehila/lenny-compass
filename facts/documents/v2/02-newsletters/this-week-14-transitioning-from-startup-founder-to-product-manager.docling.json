      "formatting": null,
      "hyperlink": null,
      "label": "text",
      "meta": null,
      "orig": "This EXACTLY the situation I found myself in when I entered Airbnb. I was the CEO of a little startup called",
      "parent": {
        "$ref": "#/groups/2"
      },
      "prov": [],
      "self_ref": "#/texts/12",
      "text": "This EXACTLY the situation I found myself in when I entered Airbnb. I was the CEO of a little startup called"
    },
    {
